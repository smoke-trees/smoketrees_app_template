{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "smoketrees_app_template",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "env": {
                "STAC_BASE_API_URL": "http://0.0.0.0:8090"
            },
        },
        {
            "name": "smoketrees_app_template (profile mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "smoketrees_app_template (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart"
        },
        {
            "name": "stac_cli",
            "cwd": "stac_cli",
            "request": "launch",
            "type": "dart"
        }
    ]
}
